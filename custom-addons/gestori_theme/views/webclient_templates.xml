<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        GESTORI THEME — Login page override
        Inyecta CSS en el <head> del HTML vía t-set="head"
        (método oficial de Odoo, más fiable que XPath sobre el body)
    -->
    <template id="gestori_login_layout" inherit_id="web.login_layout" name="Gestori Login Layout">

        <!-- Inyectar CSS en <head> justo después de t-set="no_footer" -->
        <xpath expr="//t[@t-set='no_footer']" position="after">
            <t t-set="head">
                <style>
                    /* ============================================================
                       GESTORI — Login Page
                       Azul #0d0096 | Naranja #ff6000
                       ============================================================ */

                    html, body {
                        height: 100%;
                        margin: 0;
                        padding: 0;
                        background-color: #f0f2f5 !important;
                        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI',
                                     Roboto, 'Helvetica Neue', Arial, sans-serif;
                        font-size: 14px;
                        color: #333;
                        -webkit-font-smoothing: antialiased;
                    }

                    /* Centrar verticalmente */
                    .container {
                        min-height: 100vh;
                        display: flex !important;
                        align-items: center;
                        justify-content: center;
                        padding: 2rem 1rem !important;
                        box-sizing: border-box;
                    }

                    /* Tarjeta */
                    .card {
                        background-color: #ffffff !important;
                        border: none !important;
                        border-top: 4px solid #0d0096 !important;
                        border-radius: 12px !important;
                        box-shadow: 0 4px 24px rgba(0,0,0,0.10) !important;
                        max-width: 380px !important;
                        width: 100% !important;
                        overflow: hidden;
                    }

                    .card-body {
                        padding: 2rem !important;
                    }

                    /* Logo */
                    .card .text-center img {
                        max-height: 80px !important;
                        max-width: 200px !important;
                        width: auto;
                    }

                    /* Labels */
                    label, .form-label, .col-form-label {
                        font-weight: 600;
                        font-size: 13px;
                        color: #555;
                        margin-bottom: 4px;
                        display: block;
                    }

                    /* Inputs */
                    input.form-control, .form-control {
                        width: 100%;
                        padding: 10px 13px;
                        border: 1.5px solid #dde1e7 !important;
                        border-radius: 8px !important;
                        font-size: 14px;
                        color: #333;
                        background-color: #fafafa !important;
                        box-sizing: border-box;
                        outline: none;
                        transition: border-color 0.2s, box-shadow 0.2s;
                    }

                    input.form-control:focus, .form-control:focus {
                        border-color: #0d0096 !important;
                        background-color: #fff !important;
                        box-shadow: 0 0 0 3px rgba(13,0,150,0.12) !important;
                    }

                    .mb-3 { margin-bottom: 1rem !important; }

                    /* Botón principal */
                    .btn-primary {
                        background-color: #0d0096 !important;
                        border-color: #0d0096 !important;
                        color: #fff !important;
                        border-radius: 8px !important;
                        font-weight: 600;
                        font-size: 15px;
                        padding: 11px 16px;
                        width: 100%;
                        transition: background-color 0.2s;
                    }

                    .btn-primary:hover, .btn-primary:focus {
                        background-color: #ff6000 !important;
                        border-color: #ff6000 !important;
                        color: #fff !important;
                    }

                    /* Links */
                    a { color: #0d0096; text-decoration: none; }
                    a:hover { color: #ff6000; }

                    /* Alertas */
                    .alert-danger {
                        background: #fff5f5;
                        border: 1px solid #ffcccc;
                        border-radius: 8px;
                        color: #c0392b;
                        padding: 10px 14px;
                        font-size: 13px;
                        margin-top: 12px;
                    }

                    .alert-success {
                        background: #f0fff4;
                        border: 1px solid #b7ebc8;
                        border-radius: 8px;
                        color: #1e7e34;
                        padding: 10px 14px;
                        font-size: 13px;
                    }

                    /* Footer de la tarjeta */
                    .card .border-top {
                        border-top: 1px solid #e8eaed !important;
                        margin-top: 1.5rem !important;
                        padding-top: 1rem !important;
                        font-size: 12px;
                        color: #999;
                        text-align: center;
                    }

                    /* Ocultar "Powered by Odoo" */
                    a[href*="odoo.com"] { display: none !important; }

                    @media (max-width: 420px) {
                        .card-body { padding: 1.5rem 1.25rem !important; }
                    }
                </style>
            </t>
        </xpath>

        <!-- Eliminar el link "Powered by Odoo" -->
        <xpath expr="//a[contains(@href,'odoo.com')]" position="replace"/>

    </template>
</odoo>
